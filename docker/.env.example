# Copy to docker/.env. Docker Compose reads it from next to compose.yml.

# Shared key between the UI server and the backend. At least 32 random characters, for example:
#   openssl rand -hex 32
LAYA_API_KEY=

# english, multilingual or typed-decisions
LAYA_MODEL=english
# Optional: pin a Hugging Face commit so the model cannot change under you.
LAYA_REVISION=

# Host port for the UI. It is bound to 127.0.0.1 only.
UI_PORT=3000

# --- Only for "--profile proxy": HTTPS and a login on your own domain ---
# The public address, as the browser sees it.
DOMAIN=corbel.example.com
ORIGIN=https://corbel.example.com
BASIC_AUTH_USER=
# Create with:  docker run --rm caddy:2 caddy hash-password --plaintext 'your password'
# Keep the single quotes: the hash contains $ signs that Compose would otherwise expand.
BASIC_AUTH_HASH=''
