LAYA_DEVICE=cuda
LAYA_MODEL=english
LAYA_PRECISION=bf16
LAYA_HOST=0.0.0.0
LAYA_PORT=5177
# A non-loopback LAYA_HOST (such as 0.0.0.0) needs a random key of at least 32 characters; the backend refuses to start
# without one. ./scripts/setup-backend.ps1 writes a random key only when .backend.env does not exist yet; otherwise set
# LAYA_API_KEY yourself to a random key of 32+ characters. Empty is fine with LAYA_HOST=127.0.0.1.
LAYA_API_KEY=
# Optional: pin a Hugging Face commit for reproducible experiments.
LAYA_REVISION=
